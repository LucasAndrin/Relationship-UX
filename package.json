{
  "name": "relationship-ux",
  "version": "0.1.1",
  "private": false,
  "prepublishOnly": "npm run build",
  "repository": {
    "type": "git",
    "url": "https://github.com/LucasAndrin/Relationship-UX"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core/component-stack": {
      "types": "./dist/core/component-stack/index.d.ts",
      "import": "./dist/core/component-stack/index.js"
    },
    "./core/relationships": {
      "types": "./dist/core/relationships/index.d.ts",
      "import": "./dist/core/relationships/index.js"
    },
    "./core/window-manager": {
      "types": "./dist/core/window-manager/index.d.ts",
      "import": "./dist/core/window-manager/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js"
    },
    "./main.css": "./dist/main.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "preview": "vite preview",
    "build": "run-s type-check build-only",
    "build-only": "vite build --config vite.lib.config.ts",
    "type-check": "vue-tsc --noEmit -p tsconfig.lib.json"
  },
  "peerDependencies": {
    "@floating-ui/vue": "^2.0.1",
    "pinia": "^4.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "lodash": "^4.18.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tsconfig/node24": "^24.0.5",
    "@types/lodash": "^4.17.27",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "npm-run-all2": "^9.0.3",
    "pinia": "^4.0.3",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue": "^3.5.42",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
