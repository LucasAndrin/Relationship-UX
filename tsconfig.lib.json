{
    "extends": "./tsconfig.app.json",
    "include": [
        "src/**/*.ts",
        "src/**/*.vue"
    ],
    "exclude": [
        "src/**/__tests__/*"
    ],
    "compilerOptions": {
        "noEmit": true,
        "declaration": true,
        "emitDeclarationOnly": false,
        "declarationMap": false
    }
}